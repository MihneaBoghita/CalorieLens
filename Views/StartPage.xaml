<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalorieLens.StartPage"
    BackgroundColor="#0F1115">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label 
            Text="CalorieLens"
            FontSize="38"
            TextColor="White"
            HorizontalOptions="Center"
            FontAttributes="Bold"/>

        <Label 
            Text="Scan your food. Track your macros."
            FontSize="14"
            TextColor="#A0A0A0"
            HorizontalOptions="Center"/>

        <Button 
            Text="Login"
            BackgroundColor="#22C55E"
            TextColor="Black"
            CornerRadius="15"
            HeightRequest="50"
            FontAttributes="Bold"
            Clicked="OnLoginClicked"/>

        <Button 
            Text="Create Account"
            BackgroundColor="#1F2937"
            TextColor="White"
            CornerRadius="15"
            HeightRequest="50"
            Clicked="OnRegisterClicked"/>

    </VerticalStackLayout>

</ContentPage>