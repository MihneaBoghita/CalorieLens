<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalorieLens.Views.UserDetail"
    BackgroundColor="#0F1115">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

            <Label Text="Set Up Your Profile"
                   FontSize="28" TextColor="White"
                   HorizontalOptions="Center" FontAttributes="Bold"/>

            <Entry x:Name="heightEntry" Placeholder="Height (cm)"
                   Keyboard="Numeric" TextColor="White"
                   PlaceholderColor="#888" BackgroundColor="#1F2937"
                   HeightRequest="50"/>

            <Entry x:Name="weightEntry" Placeholder="Current Weight (kg)"
                   Keyboard="Numeric" TextColor="White"
                   PlaceholderColor="#888" BackgroundColor="#1F2937"
                   HeightRequest="50"/>

            <Entry x:Name="weightGoalEntry" Placeholder="Goal Weight (kg)"
                   Keyboard="Numeric" TextColor="White"
                   PlaceholderColor="#888" BackgroundColor="#1F2937"
                   HeightRequest="50"/>

            <!-- Data tinta pentru goal weight -->
            <Label Text="Target Date for Goal Weight" TextColor="#888" FontSize="13"/>
            <Frame BackgroundColor="#1F2937" BorderColor="#374151"
                   CornerRadius="10" Padding="12,4">
                <DatePicker
                    x:Name="goalDatePicker"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    MinimumDate="01/01/2025"
                    MaximumDate="12/31/2035"
                    Format="dd MMM yyyy"
                    HeightRequest="44"/>
            </Frame>

            <Entry x:Name="ageEntry" Placeholder="Age"
                   Keyboard="Numeric" TextColor="White"
                   PlaceholderColor="#888" BackgroundColor="#1F2937"
                   HeightRequest="50"/>

            <Label Text="Sex" TextColor="#888" FontSize="13"/>
            <Picker x:Name="sexPicker" TextColor="White"
                    BackgroundColor="#1F2937" HeightRequest="50">
                <Picker.Items>
                    <x:String>Male</x:String>
                    <x:String>Female</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Activity Level" TextColor="#888" FontSize="13"/>
            <Picker x:Name="activityPicker" TextColor="White"
                    BackgroundColor="#1F2937" HeightRequest="50">
                <Picker.Items>
                    <x:String>Sedentary</x:String>
                    <x:String>Light</x:String>
                    <x:String>Moderate</x:String>
                    <x:String>Active</x:String>
                    <x:String>Very Active</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Continue" Clicked="OnContinueClicked"
                    BackgroundColor="#22C55E" TextColor="Black"
                    CornerRadius="15" HeightRequest="50"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>