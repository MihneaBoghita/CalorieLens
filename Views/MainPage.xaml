<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalorieLens.MainPage"
    BackgroundColor="#0F1115">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,50,20,10">
            <Label x:Name="greetingLabel" FontSize="22"
                   TextColor="White" FontAttributes="Bold"/>
            <Label x:Name="goalLabel" FontSize="13" TextColor="#6B7280"/>
        </VerticalStackLayout>

        <!-- Continut scrollabil -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0" Spacing="20">

                <!-- Roata principala cu macros -->
                <Grid HorizontalOptions="Center" WidthRequest="320" HeightRequest="320">
                    <GraphicsView
                        x:Name="macroRingsView"
                        WidthRequest="290"
                        HeightRequest="290"/>
                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="2">
                        <Label x:Name="caloriesEatenLabel"
                               FontSize="46" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="kcal mâncate"
                               FontSize="12" TextColor="#6B7280"
                               HorizontalOptions="Center"/>
                        <BoxView HeightRequest="1" Color="#2A2D35"
                                 Margin="10,4" HorizontalOptions="Fill"/>
                        <Label x:Name="caloriesRemainingLabel"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="#22C55E" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Legenda macros - text complet, culori corecte -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      HorizontalOptions="Center" ColumnSpacing="24" RowSpacing="10">

                    <!-- Proteine - albastru -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0"
                                           Spacing="8" HorizontalOptions="Center">
                        <BoxView Color="#3B82F6" WidthRequest="14" HeightRequest="14"
                                 CornerRadius="7" VerticalOptions="Center" BackgroundColor="Black"/>
                        <Label x:Name="proteinLabel" TextColor="White"
                               FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Carbohidrati - portocaliu -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1"
                                           Spacing="8" HorizontalOptions="Center">
                        <BoxView Color="#F59E0B" WidthRequest="14" HeightRequest="14"
                                 CornerRadius="7" VerticalOptions="Center" BackgroundColor="Black"/>
                        <Label x:Name="carbsLabel" TextColor="White"
                               FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Grasimi - rosu -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                           Spacing="8" HorizontalOptions="Center">
                        <BoxView Color="#EF4444" WidthRequest="14" HeightRequest="14"
                                 CornerRadius="7" VerticalOptions="Center" BackgroundColor="Black"/>
                        <Label x:Name="fatLabel" TextColor="White"
                               FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Zahar - mov -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1"
                                           Spacing="8" HorizontalOptions="Center">
                        <BoxView Color="#A855F7" WidthRequest="14" HeightRequest="14"
                                 CornerRadius="7" VerticalOptions="Center" BackgroundColor="Black"/>
                        <Label x:Name="sugarLabel" TextColor="White"
                               FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </Grid>

                <!-- Lista mancari de azi -->
                <Label Text="Azi ai mâncat" TextColor="White"
                       FontSize="16" FontAttributes="Bold"/>

                <CollectionView x:Name="foodList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#1A1D24" BorderColor="#2A2D35"
                                   CornerRadius="12" Padding="14,10" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding FoodName}"
                                               TextColor="White" FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding MacroSummary}"
                                               TextColor="#6B7280" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding CaloriesDisplay}"
                                           TextColor="#22C55E"
                                           FontSize="15" FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="emptyLabel"
                       Text="Nu ai mâncat nimic încă azi 🍽️"
                       TextColor="#4B5563" FontSize="14"
                       HorizontalOptions="Center"
                       IsVisible="True"/>

                <!-- Hint swipe spre jurnal -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                    <Label Text="Glisează stânga pentru Jurnal"
                           TextColor="#4B5563" FontSize="12"/>
                    <Label Text="→" TextColor="#4B5563" FontSize="12"/>
                </HorizontalStackLayout>

                <BoxView HeightRequest="80" Color="#0F1115"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Butoane fixe jos: Scaneaza + Introdu manual -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="1">
            <Button
                Grid.Column="0"
                Text="📸  Scaneaza"
                Clicked="OnOpenCamera"
                BackgroundColor="#22C55E"
                TextColor="Black"
                CornerRadius="0"
                HeightRequest="60"
                FontSize="16"
                FontAttributes="Bold"/>

            <Button
                Grid.Column="1"
                Text="✍️  Introdu mancare"
                Clicked="OnOpenManualEntry"
                BackgroundColor="#3B82F6"
                TextColor="White"
                CornerRadius="0"
                HeightRequest="60"
                FontSize="16"
                FontAttributes="Bold"/>
        </Grid>

    </Grid>
</ContentPage>