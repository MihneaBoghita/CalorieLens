<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalorieLens.Views.JournalPage"
    BackgroundColor="#0F1115"
    Title="Jurnal">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,50,20,16">
            <Label Text="📓 Jurnal alimentar"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="White"/>
            <Label Text="Istoricul tău zilnic"
                   FontSize="13" TextColor="#6B7280"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Padding="20,0,20,20">
            <VerticalStackLayout Spacing="0">

                <!-- === SECTIUNEA PROGRES GREUTATE === -->
                <Label Text="⚖️ Progres greutate"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="White" Margin="0,0,0,10"/>

                <Frame BackgroundColor="#1A1D24" BorderColor="#2A2D35"
                       CornerRadius="14" Padding="16,14" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Label Text="Start" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center"/>
                            <Label x:Name="startWeightLabel" TextColor="White" FontSize="18"
                                   FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Label Text="Acum" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center"/>
                            <Label x:Name="currentWeightLabel" TextColor="#22C55E" FontSize="18"
                                   FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Label Text="Țintă" TextColor="#6B7280" FontSize="11" HorizontalOptions="Center"/>
                            <Label x:Name="targetWeightLabel" TextColor="#3B82F6" FontSize="18"
                                   FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                    </Grid>
                </Frame>

                <!-- Lista inregistrari greutate -->
                <CollectionView x:Name="weightList" SelectionMode="None" Margin="0,0,0,12">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#111418" BorderColor="#1E2028"
                                   CornerRadius="10" Padding="14,10" Margin="0,3">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Label Grid.Column="0" Text="{Binding DateLabel}"
                                           TextColor="#9CA3AF" FontSize="13" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding WeightDisplay}"
                                           TextColor="White" FontSize="15" FontAttributes="Bold"
                                           VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="2" Text="{Binding DeltaDisplay}"
                                           TextColor="{Binding DeltaColor}" FontSize="13"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="emptyWeightLabel"
                       Text="Nicio înregistrare de greutate încă."
                       TextColor="#4B5563" FontSize="13"
                       HorizontalOptions="Center"
                       Margin="0,0,0,16"
                       IsVisible="False"/>

                <!-- Separator -->
                <BoxView HeightRequest="1" Color="#2A2D35" Margin="0,8,0,16"/>

                <!-- === SECTIUNEA JURNAL ALIMENTAR === -->
                <Label Text="🍽️ Jurnal alimentar"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="White" Margin="0,0,0,10"/>

                <CollectionView x:Name="journalList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#1A1D24" BorderColor="#2A2D35"
                                   CornerRadius="14" Padding="16,14" Margin="0,6">
                                <VerticalStackLayout Spacing="6">

                                    <Label Text="{Binding DateLabel}"
                                           FontAttributes="Bold" TextColor="#9CA3AF" FontSize="12"/>

                                    <Label Text="{Binding CaloriesDisplay}"
                                           FontSize="28" FontAttributes="Bold" TextColor="#22C55E"/>

                                    <BoxView HeightRequest="1" Color="#2A2D35"/>

                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="🔵 Proteine" TextColor="#6B7280" FontSize="11"/>
                                            <Label Text="{Binding ProteinDisplay}" TextColor="White"
                                                   FontSize="14" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="🟠 Carb." TextColor="#6B7280" FontSize="11"/>
                                            <Label Text="{Binding CarbsDisplay}" TextColor="White"
                                                   FontSize="14" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="🔴 Grăsimi" TextColor="#6B7280" FontSize="11"/>
                                            <Label Text="{Binding FatDisplay}" TextColor="White"
                                                   FontSize="14" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                                            <Label Text="🟣 Zahăr" TextColor="#6B7280" FontSize="11"/>
                                            <Label Text="{Binding SugarDisplay}" TextColor="White"
                                                   FontSize="14" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="emptyJournalLabel"
                       Text="Nicio înregistrare în jurnal încă."
                       TextColor="#4B5563" FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,60,0,0"
                       IsVisible="False"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,16,0,0">
                    <Label Text="←" TextColor="#4B5563" FontSize="12"/>
                    <Label Text="Glisează dreapta pentru azi" TextColor="#4B5563" FontSize="12"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>