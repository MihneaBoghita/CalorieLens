<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalorieLens.Views.FoodResultPage"
    Title="Analiza Mancare"
    BackgroundColor="#0F1115">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Imaginea capturata -->
            <Frame x:Name="imageFrame" CornerRadius="16" Padding="0"
                   IsClippedToBounds="True" HeightRequest="260"
                   BorderColor="#1E2028">
                <Image x:Name="foodImage" Aspect="AspectFill" HeightRequest="260"/>
            </Frame>

            <!-- Loading indicator -->
            <VerticalStackLayout x:Name="loadingLayout"
                                  HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" Color="#22C55E"
                                    HeightRequest="40" WidthRequest="40"
                                    HorizontalOptions="Center"/>
                <Label Text="Se analizeaza mancarea..."
                       TextColor="#A0A0A0" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Result card -->
            <Frame x:Name="resultCard" IsVisible="False"
                   BackgroundColor="#1A1D24" BorderColor="#22C55E"
                   CornerRadius="16" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🍽️ Rezultat Analiza"
                           FontSize="16" FontAttributes="Bold" TextColor="#22C55E"/>
                    <BoxView HeightRequest="1" BackgroundColor="#2A2D35"/>
                    <Label x:Name="resultLabel" TextColor="White"
                           FontSize="15" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Error card -->
            <Frame x:Name="errorCard" IsVisible="False"
                   BackgroundColor="#1A1D24" BorderColor="#EF4444"
                   CornerRadius="16" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="⚠️ Eroare" FontSize="16"
                           FontAttributes="Bold" TextColor="#EF4444"/>
                    <Label x:Name="errorLabel" TextColor="#A0A0A0"
                           FontSize="14" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Butoane -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                <Button x:Name="retryButton" Text="🔄 Scanează din nou" Clicked="OnScanAgain"
                        BackgroundColor="#1E2028" TextColor="White"
                        CornerRadius="22" HeightRequest="48" Padding="20,0"/>
                <Button x:Name="saveButton" Text="💾 Salvează"
                        IsVisible="False" Clicked="OnSaveResult"
                        BackgroundColor="#22C55E" TextColor="Black"
                        CornerRadius="22" HeightRequest="48" Padding="20,0"
                        FontAttributes="Bold"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>